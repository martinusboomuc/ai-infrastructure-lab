# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Data root. Defaults to a folder inside the repo, which is gitignored.
# Point it elsewhere (external drive, NAS, homelab machine) by changing this
# one line. Nothing in src/ may hardcode a path.
BANKML_DATA_ROOT=./data

# DVC cache. Keep it on the same filesystem as the data root so DVC can
# hardlink instead of copying.
BANKML_DVC_CACHE=./data/.dvc-cache

# MLflow tracking. SQLite, not the plain filesystem store ("file:./mlruns") — MLflow 3.x puts
# the filesystem backend in maintenance mode and refuses to start on it without an explicit
# opt-out (found by actually running Phase 3's training pipeline, not from the changelog).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Phase 4: where the serving app persists its JSON-lines prediction log
# (src/bankml/serving/prediction_log.py). Defaults to $BANKML_DATA_ROOT/predictions if unset —
# override for the Docker image, where BANKML_DATA_ROOT isn't mounted (see Dockerfile).
BANKML_PREDICTION_LOG_DIR=./data/predictions

# Phase 5: the durable copy of the prediction log (serving/prediction_log.py) and the drift
# job's read of it (monitoring/drift.py) both use this — optional locally, real in production.
# Quote it: the value contains ";", which an unquoted `source .env` truncates at silently.
# `az storage account show-connection-string --resource-group bankml-data-rg --name
# bankmldvcstore --query connectionString -o tsv`
AZURE_STORAGE_CONNECTION_STRING=

# Phase 5: where `make drift` pushes its results (a Prometheus Pushgateway) — optional, the job
# still runs and logs to MLflow without it, just doesn't push metrics for Grafana to alert on.
BANKML_PUSHGATEWAY_URL=http://192.168.1.136:9091
