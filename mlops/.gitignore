# Data — never committed. Tracked by DVC against a private remote.
# Not a blanket data/ ignore: DVC's .dvc pointer files live under data/ too and
# must be trackable by git. dvc add already writes a precise .gitignore entry
# for each raw file it tracks; this just covers the cache dir and raw extensions.
data/.dvc-cache/
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.gz
*.7z

# DVC internals (dvc.lock, dvc.yaml and *.dvc pointers ARE committed)
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Model artifacts
models/
*.pkl
*.joblib
*.onnx
*.cbm
*.lgb

# Generated reports
reports/
monitoring/reports/

# Serving's prediction log (Phase 4) — local runtime data, never committed. Read by Phase 5's
# drift job; the log's location is configurable via BANKML_PREDICTION_LOG_DIR, but this default
# path stays ignored regardless of where a given deployment actually points it.
data/predictions/

# Environment
.env
.env.local
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# macOS, including junk written onto external drives
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
