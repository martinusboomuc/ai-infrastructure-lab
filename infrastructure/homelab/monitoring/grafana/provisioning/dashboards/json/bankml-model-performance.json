{
  "title": "BankML Model Performance",
  "uid": "bankml-model-performance",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "title": "How to read this",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Production model performance for Credit Risk ([ADR-0021](https://github.com/martinusboomuc/ai-infrastructure-lab/blob/main/mlops/docs/decisions/0021-production-performance-on-replayed-outcomes.md)). The `performance-credit` job runs daily at 06:30 on replayed applicants whose outcome counts as known 7 days after the prediction. It measures only the production version and needs 500 predictions with outcomes, so after a promotion the live panels stay empty for about ten days while *Predictions with known outcomes* climbs. Drift (bottom row) needs no outcomes and runs at 06:00. Per-run detail is in MLflow, experiment `bankml-credit-monitoring`."
      },
      "id": 1
    },
    {
      "title": "Production version",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "bankml_performance_test_roc_auc{domain=\"credit\"}",
          "legendFormat": "v{{model_version}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "description": "The registry version the job measures, shown with its test ROC-AUC.",
      "id": 2
    },
