# Copy to .env on docker-01 and fill in real values. .env is gitignored — it holds credentials
# that don't belong in the repository.

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# From Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Install and run a connector
# (Docker) — the value after --token in the docker run command it shows you.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# ADR-0013: MLflow artifacts live on Azure Blob (bankml-data-rg/bankmldvcstore/mlflow-artifacts),
# not this host's disk. `az storage account show-connection-string --resource-group
# bankml-data-rg --name bankmldvcstore --query connectionString -o tsv`.
AZURE_STORAGE_CONNECTION_STRING=change-me
